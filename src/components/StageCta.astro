---
// The "Want to speak too?" button. On the front page it opens the "Share the stage" panel.
// Without JavaScript it goes straight to the GitHub form.
import { REPO } from '../lib/site';
---
<a class="stage-cta" href={`${REPO}/issues/new?template=speaking.yml`} data-open-stage aria-haspopup="dialog" aria-controls="share-the-stage">
  <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="14" y="4" width="12" height="20" rx="6"/><path d="M8 19a12 12 0 0 0 24 0M20 31v5M14 36h12"/></svg>
  <span><b>Want to speak too?</b><small>Take a session, or present one with me</small></span>
  <i aria-hidden="true">&rarr;</i>
</a>
